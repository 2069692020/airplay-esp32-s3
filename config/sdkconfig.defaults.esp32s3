# ESP32-S3 target defaults - default to ESP32-S3 Generic board
CONFIG_BOARD_ESP32S3_GENERIC=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_SPIRAM_MODE_OCT=y

# USB Audio Class defaults for the current usb_device_uac integration.
# Keep both streams stereo at 48 kHz so the UAC descriptors, feedback,
# and AirPlay USB backend all use the same resampled output rate.
CONFIG_UAC_SPEAKER_CHANNEL_NUM=2
CONFIG_UAC_MIC_CHANNEL_NUM=2
CONFIG_UAC_SAMPLE_RATE=48000

# ---------------------------------------------------------------------------
# GPIO defaults — tuned for N16R8 + PCM5102A + TDA1308
#
# BAT_CHANNEL and LED_RGB_GPIO are deliberately disabled: the upstream defaults
# (7 and 48) collide with other peripherals. ADC1_CH7 shares GPIO8 with the
# I2S MCLK pin, and GPIO48 has no internal pull-up so it cannot drive a WS2812
# from a floating line. See docs/boards/esp32s3-pcm5102a.md.
# ---------------------------------------------------------------------------
CONFIG_BAT_CHANNEL=-1
CONFIG_LED_RGB_GPIO=-1

# I2S -> PCM5102A.  The PCM5102A derives its own master clock from BCK, so
# CONFIG_I2S_SCK_IO must stay -1: audio_output.c assigns it to .mclk, and
# ESP32-S3 has no GPIO8 output (GPIO8 is the flash/PSRAM QIO pin).  Setting it
# would make the I2S driver try to invert a flash pin on every output start.
CONFIG_I2S_SCK_IO=-1
CONFIG_I2S_BCK_IO=12
CONFIG_I2S_WS_IO=14
CONFIG_I2S_DO_IO=13
# Must stay -1.  The PCM5102A is powered normally (VCC -> 3V3, GND -> GND), so
# the "drive GND from a GPIO" feature does not apply.  It was set to 14, which
# is also CONFIG_I2S_WS_IO: audio_output.c configures that pin as a fake GND and
# then i2s_channel_init_std_mode() re-muxes the same pin to WS, silently
# defeating it.  Harmless today only because WS wins — but any reordering of
# those two steps would hold WS low and kill audio.  -1 compiles the block out
# (guarded by `#if CONFIG_I2S_GND_IO >= 0` in audio_output.c).
CONFIG_I2S_GND_IO=-1

# ---------------------------------------------------------------------------
# OLED display — 0.96" 128x64 SSD1306, I2C variant (4-pin: GND VCC SCL SDA).
#
# Panel wiring as installed on this build:
#   SCL -> GPIO38   SDA -> GPIO39   VCC -> 3V3   GND -> GND
#
# DISPLAY_HEIGHT must stay 64 — the 128x32 layout is a different u8g2 setup
# call.  I2C address 0x3C is the common SSD1306 default; if display.c's boot
# scan reports a different address, change CONFIG_DISPLAY_I2C_ADDR to match.
#
# NOTE: this is the OLED/u8g2 path.  It is unrelated to the ST7789/LVGL block
# that used to live in this file — do not enable DISPLAY_DRIVER_ST7789 here.
# ---------------------------------------------------------------------------
CONFIG_DISPLAY_ENABLED=y
CONFIG_DISPLAY_DRIVER_SSD1306=y
CONFIG_DISPLAY_HEIGHT_64=y
CONFIG_DISPLAY_BUS_I2C=y
CONFIG_DISPLAY_I2C_SDA=39
CONFIG_DISPLAY_I2C_SCL=38
CONFIG_DISPLAY_I2C_ADDR=0x3C
CONFIG_DISPLAY_UPDATE_MS=500

# ---------------------------------------------------------------------------
# AirPlay 2 模式 (当前: 开启)
#
# 2026-09-18 从 v1 切回 v2。切回的原因:
#   - 当初开 v1 是为了安卓推流, 但**实测不通**(见 项目完整总结.md §12.3):
#     安卓系统层没有 AirPlay 发送端, 第三方 RAOP App 走 _raop._tcp 也没成。
#   - 本机按键全部 -1 (没接), 所以 v1 唯一的实际收益 (DACP 遥控能控制手机,
#     而 v2 的 MRP 未实现、播放键只能本地静音) 也用不上。
#   ⇒ v1 净收益为零, 却丢掉了 HomeKit 配对 / 多房间 / 加密传输。
#
# 若再次开启 FORCE_V1=y, 源码里 5 处分支会变 (mdns_airplay.c 与
# rtsp_handlers.{c,h}):
#   1. _airplay._tcp 服务完全不广播            (mdns_airplay.c:97)
#   2. features 从 0x1C340/0x405C4A00 -> 0x0/0x5C4A00, 摘掉 bit38/46/48
#      (HAP 配对 / 瞬态配对)                    (rtsp_handlers.h:20)
#   3. _raop._tcp TXT 换成经典 RAOP 格式, 无 pk (mdns_airplay.c:128)
#   4. /info 报 protocol_version = 1            (rtsp_handlers.c:553)
#
# ⚠️ 改这个开关 (y<->n) 之后 **必须 rm -f sdkconfig 再重编** ——
#    增量构建不会重新解析 Kconfig, 只改这一行不会生效。
#
# 想还原到已验证的 v1 固件而不用重编:
#   在 firmware_backup/ 里找对应日期的"<日期>_<主题>工作版/firmware/"，
#   整组烧回去（分区表没变时只烧 app 那一个也行）。
#   注意：还原镜像不改这个开关，下次重编仍是当前值。
# ---------------------------------------------------------------------------
CONFIG_AIRPLAY_FORCE_V1=n

# ---------------------------------------------------------------------------
# 分区表: 双 OTA 版 (16MB)
#
# 覆盖 config/sdkconfig.defaults 里的 components/boards/partitions.csv。
#   ota_0 / ota_1 各 4MB（当前固件 2.11MB，占 53%）+ storage 7.875MB。
# 2026-09-16 曾为省 flash 换成 partitions-no-ota.csv（单 app 4MB + storage
# 11.5MB）并删掉整个 OTA 通路；2026-09-19 把 OTA 恢复回来（双槽 + otadata +
# 网页升级），storage 从 11.5MB 缩到 7.875MB —— 网页文件实际只占 0.22MB，
# 换得值。详见 components/boards/partitions-16m-ota.csv 的空间账。
#
# 升级接口需要口令（NVS 里存，设置页可改）；**口令为空时 /api/ota/update 直接
# 403**，也就是默认关掉，不会出现"忘了设口令 = 局域网谁都能刷固件"的状态。
# 不想用网页升级就什么都不用改，照旧 USB 烧。
#
# ⚠️ 改这行 = 布局又变了，必须 erase_flash 一次（ota_1/storage 地址全挪）：
#      python build_fw.py erase --port COM3
#      python build_fw.py flash --port COM3
#    只想保住 WiFi 凭据时可以不擦：nvs 段(0x9000)地址在新旧两版里一致，
#    单独重写 分区表 + app + storage 即可。
# ---------------------------------------------------------------------------
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="components/boards/partitions-16m-ota.csv"

# ---------------------------------------------------------------------------
# 任务栈加大 — 为 web_radio (HTTP 流 + MP3 解码) 预留
#
# 参考 memory: ESP-IDF 音频流三大坑之一 —— 任务栈不足会让 httpd 启动失败。
#
# ⚠️ 注意: httpd 的栈**不在 Kconfig 里**, 是 httpd_config_t.stack_size
#    字段 (默认 4096), 已在 main/network/web_server.c 里直接改大。
#    这里只调 app_main 的栈。
# ---------------------------------------------------------------------------
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144


# ---------------------------------------------------------------------------
# WiFi 不许省电 —— 保证连接稳定 + 网页响应及时
#
# 本项目是"机顶盒"式用法: 一直插着电, 追求的是点击立刻有反应,
# 不是省那几毫安。让 WiFi 打盹换来的代价是:
#   · 网页/API 首包延迟变大 (几百 ms 量级), 点按钮像卡住
#   · 自动刷新时快时慢
#   · 与 AirPlay / 网络音乐拉流抢时间片, 容易撕裂音频
#
# 代码里已经调了 esp_wifi_set_ps(WIFI_PS_NONE) (main/network/wifi.c),
# 但**光有那行不够** —— 下面这个 Kconfig 是"STA 断开时也做 modem sleep",
# 它在 esp_wifi_set_ps() 管不到的路径上生效 (例如开机还没连上时)。
# IDF 默认为 y, 这里显式关掉。
#
# ⚠️ 另外两个不设的:
#   CONFIG_PM_ENABLE          —— 动态调频, 本就没开, 保持关闭
#   CONFIG_FREERTOS_USE_TICKLESS_IDLE —— 空闲进 light sleep, 同理会拖慢响应
# ---------------------------------------------------------------------------
CONFIG_ESP_WIFI_STA_DISCONNECTED_PM_ENABLE=n
