# Default values

# PSRAM support
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_FREERTOS_TASK_CREATE_ALLOW_EXT_MEM=y

# FLASH mode
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHMODE="qio"

# CPU frequency
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=240

# WiFi
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=10
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=32
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=32

# libsodium: CONFIG_LIBSODIUM_USE_MBEDTLS_SHA was removed from libsodium's
# Kconfig in 1.0.21, so setting it is now an error ("unknown config item").
# Under 5.5 it was set to n; that is the behaviour we keep by omission.

# mDNS
CONFIG_MDNS_MAX_SERVICES=10
CONFIG_MDNS_TASK_CREATE_FROM_SPIRAM=y
CONFIG_MDNS_MEMORY_ALLOC_SPIRAM=y

# mbedTLS: use default allocator so RSA MPI buffers can spill to SPIRAM
# when internal DRAM is tight (audio task stacks pre-allocated there).
CONFIG_MBEDTLS_DEFAULT_MEM_ALLOC=y

# LWIP - increase socket limits for AirPlay
CONFIG_LWIP_MAX_SOCKETS=16

# Enable SO_RCVBUF so the buffered-audio socket can use a small receive
# buffer.  We do our own jitter buffering in audio_buffer; the kernel
# should hold no more than a couple of MSS so back-pressure to the
# sender is responsive when our PCM ring runs full.
CONFIG_LWIP_SO_RCVBUF=y

# Deepen the UDP receive mailbox.  The default of 6 overflows under the
# bursty RTP delivery of AirPlay realtime (ALAC) unbuffered streams,
# dropping datagrams before the audio task can drain them (~8% loss).
# The mailbox holds pbuf pointers only (~4 bytes/slot), so this is cheap
# and cuts realtime UDP loss to ~1-2%.
CONFIG_LWIP_UDP_RECVMBOX_SIZE=64

# Logging
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_DEFAULT_LEVEL=3
CONFIG_LOG_COLORS=y

# Partition table
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="components/boards/partitions.csv"

# Compiler optimization
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# HTTP server — limit open sockets to avoid LWIP socket exhaustion.
# Default is 7; with RTSP + audio + NTP + PTP + WiFi the budget is tight.
CONFIG_HTTPD_WS_SUPPORT=y

# URI length: the SD card endpoints carry percent-encoded UTF-8 paths
# (/api/sd/upload?dir=...&name=...).  A 255-byte Chinese filename costs up to
# 765 bytes once percent-encoded, which overflows the 512-byte default and
# returns 414 URIs Too Long.  Costs ~0.5 KB of heap per open socket.
CONFIG_HTTPD_MAX_URI_LEN=1024

# Memory Tweaks
# Push allocations > 1024 bytes to SPIRAM, keeping internal DRAM free for
# semaphores, DMA descriptors and WiFi management structures that *must*
# live in internal DRAM.  Default is 16384 — far too aggressive
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=1024

# FATFS — used by the SD card reader (components/sd_card).
#
# LFN_HEAP: without long filename support every file shows up as its 8.3 short
#   name ("ARTIST~1.MP3"), which makes an SD card of music unusable.
#
# CODEPAGE_936 (GBK): ESP-IDF's FATFS has no UTF-8 mode (there is no 65001
#   codepage and no FATFS_API_ENCODING_UTF_8 option), so fatfs converts the
#   UTF-16 long filename into this OEM codepage. 936 makes readdir() hand us
#   GBK bytes, which components/sd_card/filename_enc.c converts to UTF-8.
#   A Windows-formatted card with Chinese filenames reads correctly; characters
#   outside GBK (Polish ą/ę/ł, Cyrillic, kana) come back as '?'.
#   Switch to 852 for Eastern Europe (see components/sd_card/filename_enc.c).
#
# SECTOR_4096 is left alone on purpose: IDF's ffconf.h sets
#   FF_MIN_SS = MIN(512, WL_SECTOR_SIZE) and FF_MAX_SS = MAX(...), so the two
#   differ and FATFS uses the card's real (512-byte) sector size at runtime.
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_CODEPAGE_936=y

# 热点常开（STA 连上也不再关闭 AP），所以口令必须非空。
# 随时可连 ESP32-AirPlay-Setup -> http://192.168.4.1 进配置页，
# 不用再因 DHCP 换址去路由器后台翻设备 IP。
#
# ⚠️ 真实口令**不放在这个已跟踪的文件里**。它放在本地覆盖文件
#    config/sdkconfig.user.esp32s3（已被 .gitignore 的
#    `config/sdkconfig.user.*` 忽略），build_fw.py 会在该文件存在时把它
#    追加到 defaults 链的**最后**（左到右覆盖，所以它说了算）。
#    没有这个文件的克隆会编出一个**开放热点**（Kconfig 默认就是空串）——
#    换机器/重新克隆时记得先建它，或从设备网页重新设一次。
CONFIG_DEFAULT_AP_PASSWORD=""

# AHT20 温湿度传感器（独立一条 I2C 总线，与显示面板那条互不相干）。
#
# ⚠️ SDA 不能用 GPIO45 —— 它在**本项目里已经是 SD 卡的 SCLK**
#   （CONFIG_SD_SCLK_GPIO=45），另外它还是 S3 的 VDD_SPI strapping 脚。
#   实测过的后果：把 SDA 配成 45 之后 i2c_new_master_bus() 会把这个脚重新复用
#   给 I2C，SD 卡的时钟就没了 —— 卡仍然显示"已挂载"（FATFS 的状态是缓存的），
#   但目录列表变成 0 条，症状看起来完全不像引脚冲突。
#   现在 aht20_init() 在启动期拿全部已配置外设引脚做比对，撞上就 E 级报出
#   "和谁抢"并拒绝启动该功能（不建总线，所以不会再抢别人的脚）。
# 当前接线（最终）：SDA=GPIO9、SCL=GPIO15；地址 0x38（AHT20 固定，无第二选择）。
#   这两个脚在本项目里都没有被别的外设占用。
# 采样周期 5s：网页那一格 5s 刷一次已经够，且任务优先级低不抢音频。
CONFIG_AHT20_ENABLED=y
CONFIG_AHT20_I2C_SDA=9
CONFIG_AHT20_I2C_SCL=15
CONFIG_AHT20_I2C_ADDR=0x38
# 100 kHz。这个旋钮留着是因为弱上拉/长线时降速确实有效；但本轮"三次互不吻合"
# 的真因不是信号，而是把 AHT20 的 6 字节响应按 7 字节解（温度最低位取到了帧外
# 浮空字节、湿度整体放大 16 倍）—— 已修。没接外部上拉、线又长时再调低到 20k。
CONFIG_AHT20_I2C_SPEED_KHZ=100
CONFIG_AHT20_PERIOD_MS=5000

# 互联网校时（LWIP SNTP）。注意与 main/network/ntp_clock.c 无关 —— 那个是
# AirPlay 1 的发送端时钟偏移同步，管的是音频对齐，不是"现在是几点"。
# 时区用 POSIX 写法：偏移符号相反，CST-8 即 UTC+8。
# 服务器只配一个：CONFIG_LWIP_SNTP_MAX_SERVERS 在本项目里是 1。
CONFIG_TIME_SYNC_ENABLED=y
CONFIG_TIME_SYNC_SERVER="ntp.aliyun.com"
CONFIG_TIME_SYNC_TZ="CST-8"

# ⚠️ 上面这些新增项要生效，必须同时改生成出来的 sdkconfig ——
#   改了 defaults 但 sdkconfig 已存在时 defaults 不会覆盖它（§5.2 那条坑）。
#   本轮的做法是把同样的行原样补进 sdkconfig，而不是删掉重建：
#   sdkconfig 里存着当前真正生效的全部编译选项，删了就没法比对上一版。
