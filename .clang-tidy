Checks: >
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-reserved-identifier,
  -bugprone-branch-clone,
  clang-analyzer-*,
  misc-*,
  -misc-unused-parameters,
  -misc-include-cleaner,
  -misc-no-recursion,
  -misc-header-include-cycle,
  -misc-use-internal-linkage,
  performance-*,
  -performance-no-int-to-ptr,
  portability-*,
  -portability-avoid-pragma-once,
  readability-braces-around-statements,
  readability-inconsistent-declaration-parameter-name,
  readability-misleading-indentation,
  readability-redundant-declaration,

WarningsAsErrors: ''

# 覆盖范围: main/ 和 components/ 两边都是自研代码。以前只写 main/.* 的时候,
# SD 播放器 / 网络电台 / TAS57xx+58xx / display 这些**后来加上去的大部分代码**
# 从来没被 lint 过。
#
# WarningsAsErrors 故意仍留空: 扩大覆盖会一次性冒出存量告警, 在没人看过那份
# 清单之前把它变成 CI 硬失败, 只会让人直接忽略这个 job。等清完一轮再把
# bugprone-*,clang-analyzer-* 提上去。
HeaderFilterRegex: '(main|components)/.*'

CheckOptions:
  - key: readability-identifier-naming.FunctionCase
    value: lower_case
  - key: readability-identifier-naming.VariableCase
    value: lower_case
  - key: readability-identifier-naming.MacroDefinitionCase
    value: UPPER_CASE
